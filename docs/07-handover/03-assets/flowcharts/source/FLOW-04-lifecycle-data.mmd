%% FLOW-04 - Siklus Hidup Data Operasional
flowchart TD
    A([Data Aktif]) --> B[Tampil di Publik]
    B --> C{Perlu dinonaktifkan?}
    C -- Tidak --> D([Tetap Aktif])
    C -- Ya --> E[Data Dinonaktifkan]

    E --> F[Tidak Tampil di Publik]
    F --> G{Tindakan Super Admin}

    G -- Pulihkan --> H[Pulihkan Data]
    H --> I([Data Aktif Kembali])

    G -- Hapus Mutlak --> J[Hapus Permanen]
    J --> K([Tidak Dapat Dipulihkan])

    class A,I start
    class B,F process
    class C,G decision
    class E,J,K warning
    class H superadmin
    class D finish

    classDef start fill:#EAF7EA,stroke:#2F7D4F,color:#163821,stroke-width:1.4px;
    classDef process fill:#F7FAF8,stroke:#8AA99A,color:#1F332A,stroke-width:1.2px;
    classDef decision fill:#FFF4D8,stroke:#C48A1B,color:#3B2A04,stroke-width:1.3px;
    classDef public fill:#E7F0FF,stroke:#4D75B8,color:#17345F,stroke-width:1.2px;
    classDef admin fill:#EAF7EA,stroke:#2F7D4F,color:#163821,stroke-width:1.2px;
    classDef superadmin fill:#F0EAF8,stroke:#7252A3,color:#2E1E4D,stroke-width:1.2px;
    classDef warning fill:#FDECEC,stroke:#B95B5B,color:#5A1E1E,stroke-width:1.2px;
    classDef finish fill:#EDF2EF,stroke:#6E8377,color:#1F332A,stroke-width:1.2px;
