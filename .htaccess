<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block direct access to hidden files (.env, .git, etc.)
    RewriteRule ^\.(.*)$ - [F,L]

    # 2. Block direct web access to sensitive source and doc directories
    RewriteRule ^(docs|dev-08\.md|prepod-01\.md|opencode\.json|skills-lock\.json) - [F,L,NC]
    RewriteRule ^src/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.env) - [F,L,NC]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Rewrite all public requests to src/public/
    RewriteCond %{REQUEST_URI} !^/src/public/
    RewriteRule ^(.*)$ src/public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes
